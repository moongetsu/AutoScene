{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoScene",
  "version": "0.1.0",
  "identifier": "com.autoscene.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoScene",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "maxWidth": 1280,
        "maxHeight": 800,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8741 http://localhost:8741 ws://localhost:5173 http://localhost:5173; img-src 'self' data: blob: http://127.0.0.1:8741 http://localhost:8741; media-src 'self' blob: http://127.0.0.1:8741 http://localhost:8741; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
