{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": ["src/bindings.ts", "dist"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          { "name": "lucide-react", "message": "Icons are Phosphor: import them from @/components/icons." },
          { "name": "@phosphor-icons/react", "message": "Import icons from @/components/icons." }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/icons.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@phosphor-icons/react",
                "importNames": ["Sparkle", "Lightning", "LightningA", "MagicWand", "Robot", "Star", "StarFour", "ShootingStar"],
                "message": "No decorative \"AI\" clichés: pick an icon that says what the control does (docs/DESIGN.md)."
              }
            ]
          }
        ]
      }
    }
  ]
}
