{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoScene",
  "version": "1.0.1-BETA",
  "identifier": "com.autoscene.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AutoScene",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "visible": true,
        "backgroundColor": "#0D0D0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://localhost:5173; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "AutoScene",
    "category": "Video",
    "shortDescription": "Frame-exact character scenepacks from series and movies",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tcmmi/AutoScene/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5OTExMjAyOTJGMkFDNjkKUldScHJQS1NBaEtSeVduVVFXL2RYazdsM2dIRGYzYmdobDA1RjZHRi9mdVBoT1lFQnkvM2VpQ0IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
